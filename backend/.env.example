# ── Database ──────────────────────────────────────────────────────────────────
# Get a free PostgreSQL database from: https://neon.tech or https://railway.app
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
